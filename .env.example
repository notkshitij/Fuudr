VITE_WAITLIST_SUPABASE_URL=your_supabase_url_here
VITE_WAITLIST_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Cloudinary images. The API key is public; the API secret is used only by the server-side signing endpoint.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Bunny Stream videos. These are server-only Vercel variables; never prefix the API key with VITE_.
BUNNY_STREAM_LIBRARY_ID=your_video_library_id
BUNNY_STREAM_API_KEY=your_stream_library_api_key
BUNNY_STREAM_CDN_HOSTNAME=your_stream_cdn_hostname

# Server-side aliases used to verify Supabase access tokens in API routes.
SUPABASE_URL=your_supabase_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Restrict this key to fuudr.com (HTTP referrers) and to Maps/Places APIs in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_ADMIN_ROUTE=/adminfuudr

# ---- Server-side only (set these in Vercel -> Settings -> Environment Variables, NOT with a VITE_ prefix) ----
# Must match the Authorization header configured in the Supabase "send_order_email" database webhook.
WEBHOOK_SECRET=long_random_string
GMAIL_APP_PASSWORD=your_gmail_app_password
